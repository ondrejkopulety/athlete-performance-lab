# Garmin Connect Configuration
# Copy this file to .env and fill in your actual credentials

# Garmin email address
GARMIN_EMAIL=your_email@example.com

# Garmin password (or use app key if available)
GARMIN_PASSWORD=your_password_here

# Garmin Display Name (UUID) - found in Garmin Connect API responses
# Use the format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GARMIN_DISPLAY_NAME=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================================
# DATABASE (PostgreSQL + TimescaleDB, viz docker-compose.yml)
# ============================================================
POSTGRES_USER=garmin
POSTGRES_PASSWORD=garmin
POSTGRES_DB=garmin
POSTGRES_PORT=5432

# Přepíše složené DATABASE_URL, pokud potřebuješ jiný host / vzdálenou DB
# DATABASE_URL=postgresql+psycopg://garmin:garmin@localhost:5432/garmin

# ============================================================
# API
# ============================================================
# Povolené originy pro frontend (čárkou oddělené)
API_CORS_ORIGINS=http://localhost:3000
# Noční automatický sync (APScheduler); prázdné = vypnuto
SYNC_CRON_HOUR=4

# ============================================================
# SOUKROMÍ
# ============================================================
# Místa vyloučená z botanické analýzy (domov, práce, známé falešné poplachy).
# Jsou to reálné adresy s přesností na metry – proto v .env, ne v repu.
# Formát: popisek:šířka,délka,poloměr_v_metrech;další...
EXCLUDED_LOCATIONS=domov:50.0755,14.4378,200;prace:50.0880,14.4210,200
